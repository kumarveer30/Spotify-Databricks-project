{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dfactory-spotify"
		},
		"DataLake_Spotify_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'DataLake_Spotify'"
		},
		"Sql_Spotify_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Sql_Spotify'"
		},
		"DataLake_Spotify_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://spotifyprojectsa.dfs.core.windows.net/"
		},
		"Sql_Spotify_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "spotifyserverp.database.windows.net"
		},
		"Sql_Spotify_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotifyproject"
		},
		"Sql_Spotify_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "veer"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dfactory-spotify_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"DataLake_Spotify_accountKey": {
						"value": "[parameters('DataLake_Spotify_accountKey')]"
					},
					"Sql_Spotify_password": {
						"value": "[parameters('Sql_Spotify_password')]"
					},
					"DataLake_Spotify_properties_typeProperties_url": {
						"value": "[parameters('DataLake_Spotify_properties_typeProperties_url')]"
					},
					"Sql_Spotify_properties_typeProperties_server": {
						"value": "[parameters('Sql_Spotify_properties_typeProperties_server')]"
					},
					"Sql_Spotify_properties_typeProperties_database": {
						"value": "[parameters('Sql_Spotify_properties_typeProperties_database')]"
					},
					"Sql_Spotify_properties_typeProperties_userName": {
						"value": "[parameters('Sql_Spotify_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}